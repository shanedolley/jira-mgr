{
  "name": "jira-mgr",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "prettier": "@jira-mgr/config-lint/prettier",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @jira-mgr/desktop dev",
    "typecheck": "pnpm -r typecheck && tsc -p scripts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:live": "JM_LIVE_JIRA=1 pnpm -r test",
    "e2e": "pnpm --filter @jira-mgr/desktop build && pnpm --filter @jira-mgr/e2e e2e",
    "ci:local": "pnpm install --frozen-lockfile && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:reference && git diff --exit-code -- docs/reference",
    "jm": "node scripts/jm.ts",
    "icon": "pnpm --filter @jira-mgr/desktop exec electron ../../scripts/build-icon.ts",
    "package": "pnpm --filter @jira-mgr/desktop build && node scripts/package.ts",
    "docs:reference": "pnpm --filter @jira-mgr/cli build && node scripts/gen-reference.ts",
    "fixture:record": "node packages/core/scripts/record-fixture.ts"
  },
  "devDependencies": {
    "@jira-mgr/config-lint": "workspace:*",
    "@jira-mgr/config-ts": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.0",
    "prettier": "^3.9.0",
    "typescript": "~7.0.2"
  }
}
