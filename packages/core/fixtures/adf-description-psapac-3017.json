                  "attrs": {
                    "href": "https://collibra.lightning.force.com/lightning/r/Contact/0036M00003CZXiJQAX/view"
                  }
                }
              ]
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "The contact above has applied via "
