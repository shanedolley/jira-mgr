              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "April 12th",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Ranger Candidates submit their first attempt"
                    }
                  ],
                  "attrs": {
                    "localId": "cbe170e1b07c"
                  }
                }
              ]
            },
            {
              "type": "listItem",
              "attrs": {
                "localId": "628005033acd"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "April 13th - May 1st",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Ranger Committee grades Candidate's work"
                    }
                  ],
                  "attrs": {
                    "localId": "dfb996e15ae3"
                  }
                }
              ]
            },
            {
              "type": "listItem",
              "attrs": {
                "localId": "812fcc16cb53"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "April 27th - May 8th",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Ranger Candidate Interviews and initial results are sent"
                    }
                  ],
                  "attrs": {
                    "localId": "3d54992279fc"
                  }
                }
              ]
            },
            {
              "type": "listItem",
              "attrs": {
                "localId": "eaf0bc6899a4"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "May 11th - May 22nd",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Ranger Candidates submit their revisions based on feedback "
                    },
                    {
                      "type": "text",
                      "text": "if necessary",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ],
                  "attrs": {
                    "localId": "a49a50e7ef1e"
                  }
                }
              ]
            },
            {
              "type": "listItem",
              "attrs": {
                "localId": "5a2b9111557a"
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "All Grading Due by May 29th",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Ranger Committee reviews resubmissions."
                    }
                  ],
                  "attrs": {
                    "localId": "8ecfff1d20c0"
                  }
                },
                {
                  "type": "bulletList",
                  "content": [
                    {
                      "type": "listItem",
                      "attrs": {
                        "localId": "e96dc62c752e"
                      },
                      "content": [
                        {
                          "type": "paragraph",
                          "content": [
                            {
                              "type": "text",
                              "text": "Note, if a second submission receives a failing score, the submission is reviewed again by another committee member, which can take more time."
                            }
