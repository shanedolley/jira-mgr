                  "content": [
                    {
                      "type": "text",
                      "text": "March 16th",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Ranger Candidates receive their scenario and instances"
