        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Each Question is designed to assess a perceived AI risk, however the risk itself is not directly articulated, it is instead implied in the Question text."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Infer the Risk Name from the Question."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Add the above Description."
            }
          ]
